{
    "name": "laranail/phone",
    "description": "Phone numbers for Laravel \u2014 an immutable value object over libphonenumber, input normalisation, per-country input masks, Eloquent casts and a test-number factory.",
    "keywords": [
        "laravel",
        "laranail",
        "simtabi",
        "phone",
        "phone-number",
        "libphonenumber",
        "e164",
        "msisdn"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/phone",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/phone/issues",
        "source": "https://github.com/laranail/phone",
        "docs": "https://opensource.simtabi.com/documentation/laranail/phone/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ext-mbstring": "*",
        "giggsey/libphonenumber-for-php": "^9.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laranail/package-tools": "^0.1"
    },
    "require-dev": {
        "laranail/atlas": "^0.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1",
        "rector/rector": "^2.5.8"
    },
    "suggest": {
        "ext-intl": "Localised country names via Locale::getDisplayRegion(). This package does not resolve country names itself \u2014 it deals in ISO codes \u2014 so this only matters for calling code that does.",
        "symfony/intl": "^7.0 || ^8.0 \u2014 deterministic localised country names that do not vary with the host's ICU version. Same caveat as ext-intl: consumed by your code, not by this package."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Phone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Phone\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "test-coverage": "@test --coverage --min=90",
        "lint": [
            "@pint",
            "@phpstan",
            "@rector"
        ],
        "pint": "vendor/bin/pint --test --config vendor/laranail/package-tools/pint.json",
        "pint-fix": "vendor/bin/pint --parallel --config vendor/laranail/package-tools/pint.json",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "analyse": "@phpstan",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "format": "@pint-fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Phone\\Providers\\PhoneServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/atlas"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
